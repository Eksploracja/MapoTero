    Public Sub PrzeliczenieDoWgs84ZgodneZProj(epsg As Integer, szerokosc As Double, dlugosc As Double, x As Double, y As Double)
        Dim u = UkladWspolrzednych.ZKodu(epsg)
        Dim g = u.DoWgs84(x, y)
        '1e-8 stopnia to ok. 1 mm
        Assert.InRange(g.Szerokosc - szerokosc, -0.00000001, 0.00000001)
        Assert.InRange(g.Dlugosc - dlugosc, -0.00000001, 0.00000001)
    End Sub

    <Fact>
    Public Sub KolejnoscOsiWgEpsg()
        Assert.True(UkladWspolrzednych.PL1992.NajpierwPolnoc)
        Assert.True(UkladWspolrzednych.PL2000Strefa7.NajpierwPolnoc)
        Assert.True(UkladWspolrzednych.Wgs84.NajpierwPolnoc)
        Assert.False(UkladWspolrzednych.Utm34N.NajpierwPolnoc)
    End Sub

    <Fact>
    Public Sub Wgs84BezZmian()
        Dim p = UkladWspolrzednych.Wgs84.ZWgs84(52.1, 21.3)
        Assert.Equal(52.1, p.X)
        Assert.Equal(21.3, p.Y)
    End Sub

    <Fact>
    Public Sub PrzeliczenieMiedzyUkladami()
        'PL-1992 -> PL-2000 strefa 7 i z powrotem
        Dim p As New PunktXY(487000, 637000)
        Dim q = UkladWspolrzednych.PL1992.PrzeliczDo(UkladWspolrzednych.PL2000Strefa7, p)
        Dim r = UkladWspolrzednych.PL2000Strefa7.PrzeliczDo(UkladWspolrzednych.PL1992, q)
        Assert.InRange(r.X - p.X, -0.0001, 0.0001)
        Assert.InRange(r.Y - p.Y, -0.0001, 0.0001)
    End Sub

    <Fact>
    Public Sub OpisyUkladu()
        Assert.Contains("ETRS_1989_Poland_CS92", UkladWspolrzednych.PL1992.Wkt)
        Assert.Contains("PARAMETER[""Central_Meridian"",19.0]", UkladWspolrzednych.PL1992.Wkt)
        Assert.Contains("PARAMETER[""False_Northing"",-5300000.0]", UkladWspolrzednych.PL1992.Wkt)
        Assert.Contains("ETRS_1989_Poland_CS2000_Zone_7", UkladWspolrzednych.PL2000Strefa7.Wkt)
        Assert.Contains("WGS_1984_UTM_Zone_34N", UkladWspolrzednych.Utm34N.Wkt)
        Assert.Equal("CoordSys Earth Projection 8, 33, 7, 19, 0, 0.9993, 500000, -5300000", UkladWspolrzednych.PL1992.CoordSysMapInfo)
        Assert.Equal("EPSG:2180", UkladWspolrzednych.PL1992.KodCrs)
        Assert.Same(UkladWspolrzednych.PL1992, UkladWspolrzednych.ZKodu(999))
    End Sub

End Class

Public Class PrzeliczanieZasieguTesty

    <Fact>
    Public Sub ZasiegObejmujeWszystkieNarozniki()
        Dim z As New Zasieg(500000, 600000, 501000, 601500)
        Dim w = UkladWspolrzednych.PL1992.PrzeliczZasieg(UkladWspolrzednych.PL2000Strefa7, z)
        'każdy narożnik oryginału leży wewnątrz przeliczonego zasięgu
        For Each p In New PunktXY() {z.LewyDolny, z.PrawyDolny, z.PrawyGorny, z.LewyGorny}
            Dim q = UkladWspolrzednych.PL1992.PrzeliczDo(UkladWspolrzednych.PL2000Strefa7, p)
            Assert.InRange(q.X, w.XDol, w.XGora)
            Assert.InRange(q.Y, w.YLewy, w.YPrawy)
        Next
        Assert.Equal(Math.Floor(w.XDol), w.XDol)
        Dim g = UkladWspolrzednych.PL1992.PrzeliczZasieg(UkladWspolrzednych.Wgs84, z)
        Assert.InRange(g.XDol, 52.0, 53.0)
        Assert.InRange(g.YLewy, 20.0, 22.0)
    End Sub

    <Fact>
    Public Sub RozmiarPikselaMetryStopnie()
        Dim miejsce As New PunktGeo(52, 19)
        Dim st = UkladWspolrzednych.PL1992.PrzeliczRozmiarPiksela(UkladWspolrzednych.Wgs84, 1.0, miejsce)
        Assert.InRange(st, 0.0000089, 0.0000091)  '1 m to ok. 9e-6 stopnia szerokości
        Dim m = UkladWspolrzednych.Wgs84.PrzeliczRozmiarPiksela(UkladWspolrzednych.PL1992, st, miejsce)
        Assert.InRange(m, 0.999, 1.001)
        Assert.Equal(2.0, UkladWspolrzednych.PL1992.PrzeliczRozmiarPiksela(UkladWspolrzednych.Utm34N, 2.0, miejsce))
    End Sub

End Class
