    Public Sub PrzeliczenieZWgs84ZgodneZProj(epsg As Integer, szerokosc As Double, dlugosc As Double, x As Double, y As Double)
        Dim u = UkladWspolrzednych.ZKodu(epsg)
        Dim p = u.ZWgs84(szerokosc, dlugosc)
        Assert.InRange(p.X - x, -0.001, 0.001)
        Assert.InRange(p.Y - y, -0.001, 0.001)
    End Sub

