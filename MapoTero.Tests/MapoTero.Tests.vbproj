<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testy jednostkowe biblioteki MapoTero.Core (uruchamiane poleceniem: dotnet test).
       Wartości wzorcowe przeliczeń współrzędnych pochodzą z biblioteki PROJ 9 (pyproj). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MapoTero.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MapoTero.Core\MapoTero.Core.vbproj" />
    <ProjectReference Include="..\MapoTero_v3.vbproj" />
  </ItemGroup>

</Project>
