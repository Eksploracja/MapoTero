<Project Sdk="Microsoft.NET.Sdk">

  <!-- Program MapoTero (Windows Forms, .NET 10). Logika niezależna od interfejsu - w bibliotece MapoTero.Core.
       Kompilacja: Visual Studio 2026 (18.0 lub nowszy) - MapoTero.sln - albo polecenie (z folderu głównego repozytorium):
       dotnet build MapoTero.App/MapoTero_v3.vbproj -c Release
       (folder bin\ to tylko pliki pośrednie kompilacji - nie jest wersją programu).
       Program do uruchomienia i wydania: dotnet publish MapoTero.App/MapoTero_v3.vbproj -c Release -o MapoTero_SingleFile
       (folder MapoTero_SingleFile w folderze głównym repozytorium, obok MapoTero.App) -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- kompilacja (bez uruchamiania) możliwa także poza Windows, np. w GitHub Actions na Linuksie -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MapoTero</RootNamespace>
    <AssemblyName>MapoTero</AssemblyName>
    <StartupObject>MapoTero.My.MyApplication</StartupObject>
    <MyType>WindowsForms</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <ApplicationIcon>MapoTero.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
    <!-- wersja i opis programu w My Project\AssemblyInfo.vb -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 64 bity: duże arkusze scalania i eksportu nie są ograniczone pamięcią procesu 32-bitowego;
         biblioteki natywne (SQLite) kopiowane bezpośrednio do folderu programu -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- JEDYNA rozwijana i wydawana wersja programu: pojedynczy plik MapoTero.exe (.NET Single-File) w folderze
         MapoTero_SingleFile (obok niego tylko folder warstwy i README.md). Nie zmieniaj tych ustawień i nie twórz
         publikacji wieloplikowych (cel TylkoJedenPlikExe przerywa taką publikację błędem). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
    <!-- folder programu w folderze głównym repozytorium (projekt jest w podfolderze MapoTero.App) -->
    <PublishDir>$(MSBuildProjectDirectory)\..\MapoTero_SingleFile\</PublishDir>
    <!-- zasoby formularzy (obrazy) w formacie wymaganym przez MSBuild .NET -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- przestrzenie nazw importowane w całym projekcie - jak w poprzednich wersjach -->
    <DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
    <AssemblyOriginatorKeyFile>MapoTero.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>false</SignAssembly>
    <DefaultItemExcludes>$(DefaultItemExcludes);packages\**</DefaultItemExcludes>
    <!-- 4201x/4235x - ostrzeżenia VB o niejawnych konwersjach i składni z poprzednich wersji kodu,
         SYSLIB0014 - ServicePointManager (w .NET 10 bez znaczenia, potrzebny przy kompilacji dla .NET Framework) -->
    <NoWarn>$(NoWarn);42016;41999;42017;42018;42019;42032;42036;42020;42021;42022;42353;42354;42355;SYSLIB0014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Drawing" />
    <Import Include="System.Linq" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MapoTero.Core\MapoTero.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- okno mapy (podkład OpenStreetMap / Google / Bing) oraz silnik SQLite kafelków i MBTiles -->
    <PackageReference Include="GMap.NET.WinForms" Version="2.1.7" />
    <!-- wykluczenie zbędnego Entity Framework 6 ciągniętego przez zależność SQLite z GMap.NET -->
    <PackageReference Include="EntityFramework" Version="6.4.4" ExcludeAssets="all" />
    <PackageReference Include="System.Data.SQLite.EF6" Version="1.0.115.5" ExcludeAssets="all" />
    <!-- nieużywany klient MS SQL ciągnięty przez GMap.NET: wersja bez znanych luk (ostrzeżenia NU1902/NU1903)
         i bez jego plików w programie -->
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" ExcludeAssets="all" />
  </ItemGroup>

  <!-- Ochrona przed publikacją wersji wieloplikowej (np. po zmianie ustawień albo z parametrem -p:PublishSingleFile=false):
       program wydawany jest wyłącznie jako jeden plik MapoTero.exe -->
  <Target Name="TylkoJedenPlikExe" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(PublishSingleFile)' != 'true' or '$(IncludeNativeLibrariesForSelfExtract)' != 'true'"
           Text="MapoTero publikowany jest wyłącznie jako jeden plik MapoTero.exe (PublishSingleFile i IncludeNativeLibrariesForSelfExtract muszą mieć wartość true)." />
  </Target>

  <!-- Usunięcie nieużywanych bibliotek MSSQL/JSON oraz zbędnych plików (.pdb, .config) z gotowej paczki programu -->
  <Target Name="UsunZbedneDll" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'System.Data.SqlClient' or '%(Filename)' == 'sni' or '%(Filename)' == 'Newtonsoft.Json' or '%(Extension)' == '.pdb' or '%(Extension)' == '.config'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <Compile Update="My Project\Application.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <None Update="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <CustomToolNamespace>My</CustomToolNamespace>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
    <Compile Update="My Project\Settings.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <EmbeddedResource Update="My Project\Resources.resx">
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="My Project\Resources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- pliki zbiorów map i opis programu (w folderze głównym repozytorium) kopiowane do folderu wydania -->
    <None Include="..\warstwy\*.txt" Link="warstwy\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="KopiujWarstwyPoPublikacji" AfterTargets="Publish">
    <ItemGroup>
      <PlikiWarstw Include="$(MSBuildProjectDirectory)\..\warstwy\*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(PlikiWarstw)"
          DestinationFolder="$(PublishDir)warstwy\"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\README.md"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
